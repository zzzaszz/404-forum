<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zzz.service.forum.mapper.NotificationMapper">

    <!--查询单个-->
    <select id="getEntity" resultType="zzz.service.forum.domain.pojo.NotificationPojo">
        select Id,
               UserId,
               Type,
               SourceUserId,
               TargetId,
               Content,
               IsRead,
               CreatedAt
        from Notification
        where Notification.Id = #{key}
    </select>
    <sql id="selectNotificationVo">
        select Id,
               UserId,
               Type,
               SourceUserId,
               TargetId,
               Content,
               IsRead,
               CreatedAt
        from Notification
    </sql>

    <!--查询指定行数据-->
    <select id="getPageList" parameterType="zzz.service.forum.domain.dto.QueryParam"
            resultType="zzz.service.forum.domain.pojo.NotificationPojo">
        <include refid="selectNotificationVo"/>
        where 1 = 1
        <if test="filterstr != null ">
            ${filterstr}
        </if>
        <if test="DateRange != null ">
            <if test="DateRange.DateColumn ==null or DateRange.DateColumn == ''">
                and Notification.CreatedAt BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
            <if test="DateRange.DateColumn !=null and DateRange.DateColumn != ''">
                and #{DateRange.DateColumn} BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
        </if>
        <if test="SearchPojo != null ">
            <if test="SearchType==0">
                <include refid="and"></include>
            </if>
            <if test="SearchType==1">
                <include refid="or"></include>
            </if>
        </if>
        order by ${orderBy}
        <if test="OrderType==0">asc</if>
        <if test="OrderType==1">desc</if>
    </select>
    <sql id="and">
        <if test="SearchPojo.content != null ">
            and Notification.Content like concat('%', #{SearchPojo.content}, '%')
        </if>
    </sql>
    <sql id="or">
        <trim prefix=" AND (" suffix=")" prefixOverrides="AND |OR ">
            <if test="SearchPojo.content != null ">
                or Notification.Content like concat('%', #{SearchPojo.content}, '%')
            </if>
        </trim>
    </sql>
    <!--新增所有列-->
    <insert id="insert">
        insert into Notification(Id, UserId, Type, SourceUserId, TargetId, Content, IsRead, CreatedAt)
        values (#{id}, #{userid}, #{type}, #{sourceuserid}, #{targetid}, #{content}, #{isread}, #{createdat})
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update Notification
        <set>
            <if test="userid != null">
                UserId =#{userid},
            </if>
            <if test="type != null">
                Type =#{type},
            </if>
            <if test="sourceuserid != null">
                SourceUserId =#{sourceuserid},
            </if>
            <if test="targetid != null">
                TargetId =#{targetid},
            </if>
            <if test="content != null ">
                Content =#{content},
            </if>
            <if test="isread != null">
                IsRead =#{isread},
            </if>
            <if test="createdat != null">
                CreatedAt =#{createdat},
            </if>
        </set>
        where Id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="delete">
        delete
        from Notification
        where Id = #{key}
    </delete>
</mapper>


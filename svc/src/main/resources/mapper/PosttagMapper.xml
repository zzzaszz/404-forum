<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zzz.service.forum.mapper.PosttagMapper">

    <!--查询单个-->
    <select id="getEntity" resultType="zzz.service.forum.domain.pojo.PosttagPojo">
        select Id, PostId, TagId
        from PostTag
        where PostTag.Id = #{key}
    </select>
    <sql id="selectPosttagVo">
        select Id, PostId, TagId
        from PostTag
    </sql>

    <!--查询指定行数据-->
    <select id="getPageList" parameterType="zzz.service.forum.domain.dto.QueryParam"
            resultType="zzz.service.forum.domain.pojo.PosttagPojo">
        <include refid="selectPosttagVo"/>
        where 1 = 1
        <if test="filterstr != null ">
            ${filterstr}
        </if>
        <if test="DateRange != null ">
            <if test="DateRange.DateColumn ==null or DateRange.DateColumn == ''">
                and PostTag.CreateDate BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
            <if test="DateRange.DateColumn !=null and DateRange.DateColumn != ''">
                and #{DateRange.DateColumn} BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
        </if>
        <if test="SearchPojo != null ">
            <if test="SearchType==0">
                <include refid="and"></include>
            </if>
            <if test="SearchType==1">
                <include refid="or"></include>
            </if>
        </if>
        order by ${orderBy}
        <if test="OrderType==0">asc</if>
        <if test="OrderType==1">desc</if>
    </select>
    <sql id="and">
    </sql>
    <sql id="or">
        <trim prefix=" AND (" suffix=")" prefixOverrides="AND |OR ">
        </trim>
    </sql>
    <!--新增所有列-->
    <insert id="insert">
        insert into PostTag(Id, PostId, TagId)
        values (#{id}, #{postid}, #{tagid})
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update PostTag
        <set>
            <if test="postid != null">
                PostId =#{postid},
            </if>
            <if test="tagid != null">
                TagId =#{tagid},
            </if>
        </set>
        where Id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="delete">
        delete
        from PostTag
        where Id = #{key}
    </delete>
</mapper>


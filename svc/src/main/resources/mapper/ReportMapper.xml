<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zzz.service.forum.mapper.ReportMapper">

    <!--查询单个-->
    <select id="getEntity" resultType="zzz.service.forum.domain.pojo.ReportPojo">
        select Id,
               ReportUserId,
               TargetType,
               TargetId,
               Reason,
               Description,
               Status,
               CreatedAt
        from Report
        where Report.Id = #{key}
    </select>
    <sql id="selectReportVo">
        select Id,
               ReportUserId,
               TargetType,
               TargetId,
               Reason,
               Description,
               Status,
               CreatedAt
        from Report
    </sql>

    <!--查询指定行数据-->
    <select id="getPageList" parameterType="zzz.service.forum.domain.dto.QueryParam"
            resultType="zzz.service.forum.domain.pojo.ReportPojo">
        <include refid="selectReportVo"/>
        where 1 = 1
        <if test="filterstr != null ">
            ${filterstr}
        </if>
        <if test="DateRange != null ">
            <if test="DateRange.DateColumn ==null or DateRange.DateColumn == ''">
                and Report.CreatedAt BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
            <if test="DateRange.DateColumn !=null and DateRange.DateColumn != ''">
                and #{DateRange.DateColumn} BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
        </if>
        <if test="SearchPojo != null ">
            <if test="SearchType==0">
                <include refid="and"></include>
            </if>
            <if test="SearchType==1">
                <include refid="or"></include>
            </if>
        </if>
        order by ${orderBy}
        <if test="OrderType==0">asc</if>
        <if test="OrderType==1">desc</if>
    </select>
    <sql id="and">
        <if test="SearchPojo.reason != null ">
            and Report.Reason like concat('%', #{SearchPojo.reason}, '%')
        </if>
        <if test="SearchPojo.description != null ">
            and Report.Description like concat('%', #{SearchPojo.description}, '%')
        </if>
    </sql>
    <sql id="or">
        <trim prefix=" AND (" suffix=")" prefixOverrides="AND |OR ">
            <if test="SearchPojo.reason != null ">
                or Report.Reason like concat('%', #{SearchPojo.reason}, '%')
            </if>
            <if test="SearchPojo.description != null ">
                or Report.Description like concat('%', #{SearchPojo.description}, '%')
            </if>
        </trim>
    </sql>
    <!--新增所有列-->
    <insert id="insert">
        insert into Report(Id, ReportUserId, TargetType, TargetId, Reason, Description, Status, CreatedAt)
        values (#{id}, #{reportuserid}, #{targettype}, #{targetid}, #{reason}, #{description}, #{status}, #{createdat})
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update Report
        <set>
            <if test="reportuserid != null">
                ReportUserId =#{reportuserid},
            </if>
            <if test="targettype != null">
                TargetType =#{targettype},
            </if>
            <if test="targetid != null">
                TargetId =#{targetid},
            </if>
            <if test="reason != null ">
                Reason =#{reason},
            </if>
            <if test="description != null ">
                Description =#{description},
            </if>
            <if test="status != null">
                Status =#{status},
            </if>
            <if test="createdat != null">
                CreatedAt =#{createdat},
            </if>
        </set>
        where Id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="delete">
        delete
        from Report
        where Id = #{key}
    </delete>
</mapper>


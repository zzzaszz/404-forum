<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zzz.service.forum.mapper.ContentauditMapper">

    <!--查询单个-->
    <select id="getEntity" resultType="zzz.service.forum.domain.pojo.ContentauditPojo">
        select Id,
               TargetType,
               TargetId,
               AuditType,
               RiskLevel,
               Result,
               HitWords,
               Remark,
               CreatedAt
        from ContentAudit
        where ContentAudit.Id = #{key}
    </select>
    <sql id="selectContentauditVo">
        select Id,
               TargetType,
               TargetId,
               AuditType,
               RiskLevel,
               Result,
               HitWords,
               Remark,
               CreatedAt
        from ContentAudit
    </sql>

    <!--查询指定行数据-->
    <select id="getPageList" parameterType="zzz.service.forum.domain.dto.QueryParam"
            resultType="zzz.service.forum.domain.pojo.ContentauditPojo">
        <include refid="selectContentauditVo"/>
        where 1 = 1
        <if test="filterstr != null ">
            ${filterstr}
        </if>
        <if test="DateRange != null ">
            <if test="DateRange.DateColumn ==null or DateRange.DateColumn == ''">
                and ContentAudit.CreatedAt BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
            <if test="DateRange.DateColumn !=null and DateRange.DateColumn != ''">
                and #{DateRange.DateColumn} BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
        </if>
        <if test="SearchPojo != null ">
            <if test="SearchType==0">
                <include refid="and"></include>
            </if>
            <if test="SearchType==1">
                <include refid="or"></include>
            </if>
        </if>
        order by ${orderBy}
        <if test="OrderType==0">asc</if>
        <if test="OrderType==1">desc</if>
    </select>
    <sql id="and">
        <if test="SearchPojo.hitwords != null ">
            and ContentAudit.HitWords like concat('%', #{SearchPojo.hitwords}, '%')
        </if>
        <if test="SearchPojo.remark != null ">
            and ContentAudit.Remark like concat('%', #{SearchPojo.remark}, '%')
        </if>
    </sql>
    <sql id="or">
        <trim prefix=" AND (" suffix=")" prefixOverrides="AND |OR ">
            <if test="SearchPojo.hitwords != null ">
                or ContentAudit.HitWords like concat('%', #{SearchPojo.hitwords}, '%')
            </if>
            <if test="SearchPojo.remark != null ">
                or ContentAudit.Remark like concat('%', #{SearchPojo.remark}, '%')
            </if>
        </trim>
    </sql>
    <!--新增所有列-->
    <insert id="insert">
        insert into ContentAudit(Id, TargetType, TargetId, AuditType, RiskLevel, Result, HitWords, Remark, CreatedAt)
        values (#{id}, #{targettype}, #{targetid}, #{audittype}, #{risklevel}, #{result}, #{hitwords}, #{remark},
                #{createdat})
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update ContentAudit
        <set>
            <if test="targettype != null">
                TargetType =#{targettype},
            </if>
            <if test="targetid != null">
                TargetId =#{targetid},
            </if>
            <if test="audittype != null">
                AuditType =#{audittype},
            </if>
            <if test="risklevel != null">
                RiskLevel =#{risklevel},
            </if>
            <if test="result != null">
                Result =#{result},
            </if>
            <if test="hitwords != null ">
                HitWords =#{hitwords},
            </if>
            <if test="remark != null ">
                Remark =#{remark},
            </if>
            <if test="createdat != null">
                CreatedAt =#{createdat},
            </if>
        </set>
        where Id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="delete">
        delete
        from ContentAudit
        where Id = #{key}
    </delete>
</mapper>


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zzz.service.forum.mapper.UserdeviceMapper">

    <!--查询单个-->
    <select id="getEntity" resultType="zzz.service.forum.domain.pojo.UserdevicePojo">
        select Id,
               UserId,
               DeviceId,
               DeviceFingerprint,
               Os,
               Browser,
               Ip,
               UserAgent,
               CreatedAt
        from UserDevice
        where UserDevice.Id = #{key}
    </select>
    <sql id="selectUserdeviceVo">
        select Id,
               UserId,
               DeviceId,
               DeviceFingerprint,
               Os,
               Browser,
               Ip,
               UserAgent,
               CreatedAt
        from UserDevice
    </sql>

    <!--查询指定行数据-->
    <select id="getPageList" parameterType="zzz.service.forum.domain.dto.QueryParam"
            resultType="zzz.service.forum.domain.pojo.UserdevicePojo">
        <include refid="selectUserdeviceVo"/>
        where 1 = 1
        <if test="filterstr != null ">
            ${filterstr}
        </if>
        <if test="DateRange != null ">
            <if test="DateRange.DateColumn ==null or DateRange.DateColumn == ''">
                and UserDevice.CreatedAt BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
            <if test="DateRange.DateColumn !=null and DateRange.DateColumn != ''">
                and #{DateRange.DateColumn} BETWEEN #{DateRange.StartDate} and #{DateRange.EndDate}
            </if>
        </if>
        <if test="SearchPojo != null ">
            <if test="SearchType==0">
                <include refid="and"></include>
            </if>
            <if test="SearchType==1">
                <include refid="or"></include>
            </if>
        </if>
        order by ${orderBy}
        <if test="OrderType==0">asc</if>
        <if test="OrderType==1">desc</if>
    </select>
    <sql id="and">
        <if test="SearchPojo.deviceid != null ">
            and UserDevice.DeviceId like concat('%', #{SearchPojo.deviceid}, '%')
        </if>
        <if test="SearchPojo.devicefingerprint != null ">
            and UserDevice.DeviceFingerprint like concat('%', #{SearchPojo.devicefingerprint}, '%')
        </if>
        <if test="SearchPojo.os != null ">
            and UserDevice.Os like concat('%', #{SearchPojo.os}, '%')
        </if>
        <if test="SearchPojo.browser != null ">
            and UserDevice.Browser like concat('%', #{SearchPojo.browser}, '%')
        </if>
        <if test="SearchPojo.ip != null ">
            and UserDevice.Ip like concat('%', #{SearchPojo.ip}, '%')
        </if>
        <if test="SearchPojo.useragent != null ">
            and UserDevice.UserAgent like concat('%', #{SearchPojo.useragent}, '%')
        </if>
    </sql>
    <sql id="or">
        <trim prefix=" AND (" suffix=")" prefixOverrides="AND |OR ">
            <if test="SearchPojo.deviceid != null ">
                or UserDevice.DeviceId like concat('%', #{SearchPojo.deviceid}, '%')
            </if>
            <if test="SearchPojo.devicefingerprint != null ">
                or UserDevice.DeviceFingerprint like concat('%', #{SearchPojo.devicefingerprint}, '%')
            </if>
            <if test="SearchPojo.os != null ">
                or UserDevice.Os like concat('%', #{SearchPojo.os}, '%')
            </if>
            <if test="SearchPojo.browser != null ">
                or UserDevice.Browser like concat('%', #{SearchPojo.browser}, '%')
            </if>
            <if test="SearchPojo.ip != null ">
                or UserDevice.Ip like concat('%', #{SearchPojo.ip}, '%')
            </if>
            <if test="SearchPojo.useragent != null ">
                or UserDevice.UserAgent like concat('%', #{SearchPojo.useragent}, '%')
            </if>
        </trim>
    </sql>
    <!--新增所有列-->
    <insert id="insert">
        insert into UserDevice(Id, UserId, DeviceId, DeviceFingerprint, Os, Browser, Ip, UserAgent, CreatedAt)
        values (#{id}, #{userid}, #{deviceid}, #{devicefingerprint}, #{os}, #{browser}, #{ip}, #{useragent},
                #{createdat})
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update UserDevice
        <set>
            <if test="userid != null">
                UserId =#{userid},
            </if>
            <if test="deviceid != null ">
                DeviceId =#{deviceid},
            </if>
            <if test="devicefingerprint != null ">
                DeviceFingerprint =#{devicefingerprint},
            </if>
            <if test="os != null ">
                Os =#{os},
            </if>
            <if test="browser != null ">
                Browser =#{browser},
            </if>
            <if test="ip != null ">
                Ip =#{ip},
            </if>
            <if test="useragent != null ">
                UserAgent =#{useragent},
            </if>
            <if test="createdat != null">
                CreatedAt =#{createdat},
            </if>
        </set>
        where Id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="delete">
        delete
        from UserDevice
        where Id = #{key}
    </delete>
</mapper>

